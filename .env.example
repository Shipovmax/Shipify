# Spotify application credentials.
# Get them at https://developer.spotify.com/ -> Create app.
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Must exactly match a Redirect URI registered in your Spotify app settings.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback

# Where the OAuth token cache is stored (relative to the project root).
SPOTIFY_CACHE_PATH=.spotify_cache
